{
  "manifest_version": 3,
  "name": "Stripe Dashboard Dark Mode",
  "version": "1.0.0",
  "description": "Affiche le Stripe Dashboard en dark mode. Clic sur l'icône pour activer/désactiver.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Stripe Dark Mode : activer/désactiver" },
  "content_scripts": [
    {
      "matches": ["https://dashboard.stripe.com/*"],
      "css": ["dark.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
